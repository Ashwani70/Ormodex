# Ormodex ERP — frontend environment variables (production template)
#
# IMPORTANT: these are CRA build-time variables — react-scripts/craco inlines
# them into the JS bundle at `npm run build` time. Changing them requires a
# rebuild + redeploy; they are NOT read at runtime like a server env var.
# (The Electron desktop build is the one exception — it overrides the backend
# URL at runtime via its own IPC bridge; see desktop/README.md.)

# Your deployed backend's public URL (no trailing slash). The app appends
# /api itself (see src/lib/api.js).
REACT_APP_BACKEND_URL=https://api.ormodex.com

# Shown in crash reports / a future About screen. Bump alongside releases;
# purely cosmetic, does not gate anything.
REACT_APP_VERSION=1.0.0

# Local dev server port only — has no effect on the production build.
PORT=3000
