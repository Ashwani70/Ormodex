# Ormodex ERP — FastAPI backend systemd unit.
# Install: sudo cp deploy/erp-backend.service /etc/systemd/system/erp-backend.service
#          sudo systemctl daemon-reload
#          sudo systemctl enable --now erp-backend
#
# Mirrors backend/Dockerfile's production process model (Gunicorn supervising
# Uvicorn workers) instead of bare `uvicorn main:app`, so a crashed worker is
# auto-restarted without the whole service going down.

[Unit]
Description=Ormodex ERP - FastAPI backend (Gunicorn/Uvicorn)
After=network.target
# Uncomment if you also run backups/other units that should not overlap a restart:
# Wants=network-online.target
# After=network-online.target

[Service]
Type=notice
User=erpapp
Group=erpapp
WorkingDirectory=/var/www/erp/Ormodex/backend
EnvironmentFile=/var/www/erp/Ormodex/backend/.env
ExecStart=/var/www/erp/Ormodex/backend/venv/bin/gunicorn \
    -k uvicorn.workers.UvicornWorker \
    -c /var/www/erp/Ormodex/backend/gunicorn.conf.py \
    main:app

ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=30
Restart=always
RestartSec=3

# ── Hardening ────────────────────────────────────────────────────────────
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/erp/Ormodex/backend/uploads /var/www/erp/Ormodex/backend/logs
LimitNOFILE=65536

# ── Resource limits (tune for your VPS plan) ────────────────────────────
MemoryMax=1536M
TasksMax=512

StandardOutput=journal
StandardError=journal
SyslogIdentifier=erp-backend

[Install]
WantedBy=multi-user.target
