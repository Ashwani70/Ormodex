# Ormodex ERP — backend environment variables for the Hostinger VPS deployment.
#
# This is deploy/backend.env.example — a VPS-specific copy of
# backend/.env.example with the Railway-only notes swapped for VPS ones.
# Copy to /var/www/erp/backend/.env on the server (chmod 600, owned by
# erpapp:erpapp). NEVER commit a real .env.

# ── Environment ───────────────────────────────────────────────────────────
ENV=production
PORT=8001
HOST=127.0.0.1
WEB_CONCURRENCY=5

# ── Database: Supabase Postgres ──────────────────────────────────────────
# Use the TRANSACTION POOLER (port 6543, host aws-*.pooler.supabase.com) —
# the direct :5432 host is IPv6-only and most VPS providers (Hostinger
# included, unless you've enabled IPv6) can't reach it.
# Format: postgresql://postgres.<ref>:[PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<supabase-anon-or-publishable-key>
SUPABASE_SECRET_KEY=<supabase-service-role-key---keep-server-side-only>
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

DB_NAME=gravity_erp

# ── Auth / JWT ────────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=<generate-a-long-random-secret-never-reuse-dev-value>
FRONTEND_URL=https://erp.yourdomain.com
CORS_ORIGINS=https://erp.yourdomain.com

# ── At-rest encryption for stored secrets (GST/e-Way Bill credentials etc.) ─
# REQUIRED in production. Generate once with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Treat as one-time-set — back it up outside the VPS (e.g. in your password
# manager), losing it makes any already-encrypted secrets unrecoverable.
SETTINGS_ENCRYPTION_KEY=<generate-and-store-in-a-secrets-manager>

# ── Initial admin bootstrap (used only on first-ever startup/seed) ─────────
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=<strong-unique-password-rotate-after-first-login>
ADMIN_SYNC_PASSWORD=false

# ── Email (Resend) ──────────────────────────────────────────────────────
RESEND_API_KEY=<resend-api-key>
RESEND_FROM=no-reply@yourdomain.com
RESEND_REPLY_TO=support@yourdomain.com

# ── Login / MFA ───────────────────────────────────────────────────────────
LOGIN_COMPANY_CODE=
MFA_ISSUER=Ormodex ERP
PASSWORD_MIN_LENGTH=8

# ── AI assistant provider (pick ONE; only its key is required) ────────────
AI_PROVIDER=gemini
GEMINI_API_KEY=<if-using-gemini>
# ANTHROPIC_API_KEY=<if-using-claude>
# GROQ_API_KEY=<if-using-groq>
# OPENAI_API_KEY=<if-using-openai>

# ── RapidAPI (GST verification / filing lookups) ──────────────────────────
RAPIDAPI_KEY=<rapidapi-key>
RAPIDAPI_HOST=<rapidapi-host>
RAPIDAPI_FILING_HOST=<rapidapi-filing-host>
RAPIDAPI_INSIGHTS_KEY=<rapidapi-insights-key>
RAPIDAPI_INSIGHTS_HOST=<rapidapi-insights-host>

# ── e-Way Bill (EWB) integration ──────────────────────────────────────────
EWB_BASE_URL=<ewb-provider-base-url>
EWB_CLIENT_ID=<ewb-client-id>
EWB_CLIENT_SECRET=<ewb-client-secret>
EWB_USERNAME=<ewb-username>
EWB_PASSWORD=<ewb-password>
EWB_GSTIN=<your-company-gstin>
EWB_ENV=production

# ── e-Invoice / IRP integration (optional — leave blank if unused) ───────
IRP_PROVIDER=
IRP_BASE_URL=
IRP_CLIENT_ID=
IRP_CLIENT_SECRET=
IRP_USERNAME=
IRP_PASSWORD=
IRP_ENVIRONMENT=production

# ── File storage ──────────────────────────────────────────────────────────
# On the VPS this is real persistent local disk (unlike Railway's ephemeral
# container filesystem) — no volume mount needed, just make sure this path
# is included in your backup routine (see deploy/backup_db.sh's sibling
# note, or add a separate rsync/tar cron for this directory).
LOCAL_STORAGE_DIR=/var/www/erp/backend/uploads

# ── App identity / misc ────────────────────────────────────────────────────
APP_NAME=gew-erp

# ── Rate limiting (see core/rate_limit.py) ─────────────────────────────────
BYPASS_RATE_LIMIT=false

# ── Diagnostics / operational flags ───────────────────────────────────────
SKIP_STARTUP_SEED=true
# SKIP_POOL_WARMUP=false
# SQL_TIMING=false
# SQL_TIMING_LOG=false
# SQL_SLOW_MS=200
# SCHEMA_DRIFT_SYNC=false

# CSRF enforcement — confirm frontend/src/lib/api.js sends X-CSRF-Token
# correctly against this deployment before flipping to true, then ship
# with it true. Do not leave production on log-only long-term.
CSRF_ENFORCE=true
