# Ormodex ERP — frontend build-time environment variables (Hostinger VPS).
#
# CRA/craco inlines these into the JS bundle at `npm run build` time — they
# are NOT read at runtime. Changing them requires rebuilding and redeploying
# (the GitHub Actions workflow does this on every push to main).
#
# Copy to frontend/.env on the VPS (or set as repo variables consumed by the
# GitHub Actions workflow — see deploy/deploy.sh) before running the build.

# Same-origin deployment: Nginx serves the SPA and proxies /api on the same
# domain, so this is just the domain itself (api base is same-origin, app
# appends /api itself — see src/lib/api.js).
REACT_APP_BACKEND_URL=https://api.ormodex.com

REACT_APP_VERSION=1.0.0
PORT=3000
