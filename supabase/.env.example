# Supabase Environment Variables Example
# Copy these keys from the Supabase Dashboard's API settings or Connect dialog.
# Never commit the actual SUPABASE_SECRET_KEY to git.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SECRET_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/certs
