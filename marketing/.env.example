# Marketing site environment. Copy to .env.local for local dev, set in Vercel for prod.

# ERP backend API base for lead capture (POST /public/demo-request).
NEXT_PUBLIC_ERP_API_BASE=http://localhost:8000/api

# Live ERP product app URL. The website Login button deep-links to its /login route
# (and /logout). The local CRA app (frontend/.env) runs on PORT 3001, not 3000.
# In prod this is typically https://app.gravityone.com
NEXT_PUBLIC_ERP_APP_URL=http://localhost:3001

# Desktop installers. By default the download buttons point at this GitHub repo's
# Releases (latest/download/<asset>), produced by .github/workflows/desktop-release.yml.
NEXT_PUBLIC_GH_RELEASES_REPO=Ashwani70/Gravity-engineering-works-ERP
NEXT_PUBLIC_APP_VERSION=2.4.0
# Optional: override individual installer URLs (e.g. if you host on S3/CDN instead).
NEXT_PUBLIC_DOWNLOAD_WINDOWS=
NEXT_PUBLIC_DOWNLOAD_MAC=
NEXT_PUBLIC_DOWNLOAD_LINUX=

# Public site URL (used for canonical URLs, sitemap, OpenGraph).
NEXT_PUBLIC_SITE_URL=https://gravityone.com

# Google Analytics measurement id (optional). e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# WhatsApp number for the floating button (country code + number, digits only, no +).
NEXT_PUBLIC_WHATSAPP=919056908758
