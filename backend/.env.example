# Ormodex ERP — backend environment variables (production template)
#
# Copy this to `.env` for local dev, or set these as Railway service variables
# for production (Railway → Project → Service → Variables). NEVER commit a
# real `.env` — it's already gitignored (see .gitignore's `*.env` rule).

# ── Environment ───────────────────────────────────────────────────────────
ENV=production

# ── Database: Supabase Postgres ──────────────────────────────────────────
# Supabase dashboard → Project Settings → Database → Connection string → URI.
# Use the TRANSACTION POOLER (port 6543, host aws-*.pooler.supabase.com) in
# production — the direct host (db.<ref>.supabase.co:5432) is IPv6-only and
# will fail to connect from most PaaS networks (see core/db.py's detection
# logic and pooler-specific handling; this is not optional for Railway).
# Format: postgresql://postgres.<ref>:[PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<supabase-anon-or-publishable-key>
SUPABASE_SECRET_KEY=<supabase-service-role-key---keep-server-side-only>
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

DB_NAME=gravity_erp

# ── Auth / JWT ────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=<generate-a-long-random-secret-never-reuse-dev-value>
FRONTEND_URL=https://erp.mycompany.com

# Only needed when the API and the frontend live on different subdomains of
# the same registrable domain (e.g. api.erp.mycompany.com serving
# app.erp.mycompany.com). Scopes the CSRF double-submit cookie so
# document.cookie on the frontend's origin can actually see it — otherwise
# the cookie defaults to the exact host that set it (the API) and the
# frontend's JS can never read it to echo back as X-CSRF-Token, even though
# the browser still silently attaches the cookie to the request itself. Leave
# unset when the API and frontend share one exact host.
# CSRF_COOKIE_DOMAIN=.erp.mycompany.com

# ── At-rest encryption for stored secrets (GST/e-Way Bill credentials etc.) ─
# REQUIRED in production — without this, secrets saved via admin settings
# screens are stored in PLAINTEXT (see core/crypto.py). Generate once with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating this key after secrets are already encrypted requires re-encrypting
# them — treat it as a one-time-set, back-it-up-safely value.
SETTINGS_ENCRYPTION_KEY=<generate-and-store-in-a-secrets-manager>

# ── Initial admin bootstrap (used only on first-ever startup/seed) ─────────
ADMIN_EMAIL=admin@mycompany.com
ADMIN_PASSWORD=<strong-unique-password-rotate-after-first-login>
ADMIN_SYNC_PASSWORD=false

# ── Email (Resend) ──────────────────────────────────────────────────────
RESEND_API_KEY=<resend-api-key>
RESEND_FROM=no-reply@mycompany.com
RESEND_REPLY_TO=support@mycompany.com

# ── Login / MFA ───────────────────────────────────────────────────────────
LOGIN_COMPANY_CODE=
MFA_ISSUER=Ormodex ERP
PASSWORD_MIN_LENGTH=8

# ── AI assistant provider (pick ONE; only its key is required) ────────────
AI_PROVIDER=gemini
GEMINI_API_KEY=<if-using-gemini>
# ANTHROPIC_API_KEY=<if-using-claude>
# GROQ_API_KEY=<if-using-groq>
# OPENAI_API_KEY=<if-using-openai>

# ── RapidAPI (GST verification / filing lookups) ──────────────────────────
RAPIDAPI_KEY=<rapidapi-key>
RAPIDAPI_HOST=<rapidapi-host>
RAPIDAPI_FILING_HOST=<rapidapi-filing-host>
RAPIDAPI_INSIGHTS_KEY=<rapidapi-insights-key>
RAPIDAPI_INSIGHTS_HOST=<rapidapi-insights-host>

# ── e-Way Bill (EWB) integration ──────────────────────────────────────────
EWB_BASE_URL=<ewb-provider-base-url>
EWB_CLIENT_ID=<ewb-client-id>
EWB_CLIENT_SECRET=<ewb-client-secret>
EWB_USERNAME=<ewb-username>
EWB_PASSWORD=<ewb-password>
EWB_GSTIN=<your-company-gstin>
EWB_ENV=production

# ── e-Invoice / IRP integration (optional — leave blank if unused) ───────
IRP_PROVIDER=
IRP_BASE_URL=
IRP_CLIENT_ID=
IRP_CLIENT_SECRET=
IRP_USERNAME=
IRP_PASSWORD=
IRP_ENVIRONMENT=production

# ── File storage ──────────────────────────────────────────────────────────
# On Railway this MUST point at a mounted Volume's path, or every uploaded
# file (product images, company logos, generated PDFs) is lost on the next
# deploy/restart — the container filesystem is otherwise ephemeral.
# Railway: attach a Volume to this service, mount path e.g. /data/uploads.
LOCAL_STORAGE_DIR=/data/uploads

# ── App identity / misc ────────────────────────────────────────────────────
APP_NAME=gew-erp

# ── Runtime tuning (Railway sets PORT automatically; don't hardcode it) ───
# WEB_CONCURRENCY=2

# ── Rate limiting (see core/rate_limit.py) ─────────────────────────────────
# Leave unset/false in production. Only ever "true" in a local dev shell when
# you're hammering the login endpoint during testing.
BYPASS_RATE_LIMIT=false

# ── Diagnostics / operational flags ───────────────────────────────────────
# SKIP_STARTUP_SEED=true       # set true after the first successful deploy
# SKIP_POOL_WARMUP=false
# SQL_TIMING=false
# SQL_TIMING_LOG=false
# SQL_SLOW_MS=200
# SCHEMA_DRIFT_SYNC=false

# CSRF enforcement — defaults to LOG-ONLY (see server.py's csrf_check
# middleware): mismatches are logged but requests are NOT blocked, until this
# is explicitly set to true. Confirm the web app (frontend/src/lib/api.js) and
# any desktop/Electron client are correctly sending X-CSRF-Token on
# state-changing requests, THEN set this — don't ship to production still on
# log-only.
CSRF_ENFORCE=true
